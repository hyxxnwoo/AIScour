# 운영 환경 템플릿
# 실제 배포 시에는 이 파일의 값을 시크릿 매니저(AWS Secrets Manager, HashiCorp Vault 등)에서 주입할 것을 권장한다.
# 이 파일은 .gitignore 에 의해 커밋되지 않는다.
NODE_ENV=production

VITE_APP_TITLE="Bridge Scour 3D Dashboard"
VITE_API_BASE_URL="/api"
VITE_LOG_LEVEL="info"

BACKEND_PORT=8000

POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=scour_prod_user
POSTGRES_PASSWORD=__REPLACE_WITH_SECRET__
POSTGRES_DB=bridge_scour

REDIS_HOST=redis
REDIS_PORT=6379

STORAGE_PATH=/var/lib/scour/storage
