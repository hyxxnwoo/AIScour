# =====================================================
# 프론트엔드 환경 변수 (Vite는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출함)
# =====================================================
VITE_APP_TITLE="Bridge Scour 3D Dashboard"
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://localhost:8000"
VITE_LOG_LEVEL="info"

# =====================================================
# 백엔드 환경 변수 (서버 컨테이너에서만 사용)
# =====================================================
NODE_ENV="development"
BACKEND_PORT=8000

# 데이터베이스
POSTGRES_HOST="database"
POSTGRES_PORT=5432
POSTGRES_USER="scour_user"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_DB="bridge_scour"

# 캐시(선택)
REDIS_HOST="redis"
REDIS_PORT=6379

# 파일 스토리지 마운트 경로
STORAGE_PATH="/var/lib/scour/storage"
