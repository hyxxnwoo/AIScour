# 개발 환경 (로컬 docker-compose.dev.yml 사용 시 기본값)
NODE_ENV=development

VITE_APP_TITLE="Bridge Scour 3D Dashboard (DEV)"
VITE_API_BASE_URL="/api"
VITE_API_PROXY_TARGET="http://backend:8000"
VITE_LOG_LEVEL="debug"

BACKEND_PORT=8000

POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=scour_user
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_DB=bridge_scour_dev

REDIS_HOST=redis
REDIS_PORT=6379

STORAGE_PATH=/var/lib/scour/storage
